# ==========================================
# ASP.NET Core Environment
# ==========================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ==========================================
# SQL Server
# ==========================================

SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=FinancialControlDb
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=CHANGE_TO_YOUR_PASSWORD

# Connection string used by the application
ConnectionStrings__DefaultConnection=Server=${SQLSERVER_HOST},${SQLSERVER_PORT};Database=${SQLSERVER_DATABASE};User Id=${SQLSERVER_USER};Password=${SQLSERVER_PASSWORD};TrustServerCertificate=True;

# ==========================================
# JWT
# ==========================================

Jwt__Key=CHANGE_THIS_KEY_TO_ONE_WITH_32_OR_MORE_CHARACTERS
Jwt__Issuer=FinancialControl.Api
Jwt__Audience=FinancialControl.Client
Jwt__ExpirationInHours=24